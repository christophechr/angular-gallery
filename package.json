{
  "name": "angular-gallery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "styles": "tailwindcss -i src/styles.css -o src/generated.css --minify",
    "start": "pnpm styles && ng serve --host 127.0.0.1",
    "build": "pnpm styles && ng build",
    "dev": "pnpm styles && ng serve --host 127.0.0.1",
    "serve:ssr": "node dist/gallery/server/server.mjs"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "20.3.33",
    "@angular/router": "20.3.33",
    "@angular/ssr": "20.3.37",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  }
}
